# Copy this file to ".env" and edit the values.

PORT=5000

# MongoDB (local Docker, local install, or MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/shortlinks

# Redis (cache + BullMQ queue). Leave EMPTY to run without Redis:
# the app then uses an in-memory cache and an in-process queue.
REDIS_URL=redis://127.0.0.1:6379

# Secrets: change both in production
JWT_SECRET=change-me-to-a-long-random-string
IP_SALT=change-me-too

# Where short links point to (the backend URL) and where the React app runs
BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# DEMO ONLY: localhost clicks have no real country. When true, clicks from
# private/local IPs get a random country so the dashboard looks alive.
# Set to false in production.
DEMO_GEO=true

# Set to 1 when deployed behind a proxy (Render, Railway, Nginx) so req.ip is the real client IP
TRUST_PROXY=0
